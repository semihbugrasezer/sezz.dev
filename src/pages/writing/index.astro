---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import EntryList from '../../components/EntryList.astro';
import { readingTime } from '../../lib/site';

const posts = (await getCollection('writing', (e) => !e.data.draft)).sort((a, b) => +b.data.created - +a.data.created);
const toItem = (e: (typeof posts)[number]) => ({
  href: `/${e.data.slug}/`,
  title: e.data.title,
  description: e.data.description,
  date: e.data.created,
  label: e.data.kind === 'learning-note' ? `Learning note · ${e.data.source?.name ?? ''}` : e.data.topic,
  minutes: readingTime(e.body),
});
const articles = posts.filter((p) => p.data.kind === 'article').map(toItem);
const notes = posts.filter((p) => p.data.kind === 'learning-note');
const reactTags = ['react', 'redux', 'redux-toolkit', 'jsx', 'typescript'];
const groupOf = (n: (typeof notes)[number]) =>
  n.data.topic === 'Agentic AI' ? 'AI tooling' : n.data.tags.some((t) => reactTags.includes(t)) ? 'React & TypeScript' : 'JavaScript';
const noteGroups = [...new Set(notes.map(groupOf))];
---

<Base title="Writing" description="Engineering articles and technical learning notes on backend engineering, agentic AI, JavaScript, React and TypeScript.">
  <header class="wrap page-head">
    <p class="eyebrow">Writing</p>
    <h1>Engineering writing</h1>
    <p class="lede">
      Articles from my own engineering work, and learning notes I keep while studying official documentation.
      Learning notes are summaries of the cited source, not original research.
    </p>
    <p class="meta" style="margin-top:var(--s-4)"><a href="/search/">Search all writing</a> · <a href="/feed_rss_created.xml">RSS</a></p>
  </header>

  <div class="wrap">
    <section class="block" aria-labelledby="articles-h">
      <h2 id="articles-h" class="eyebrow">Articles</h2>
      <EntryList items={articles} />
      <p class="meta hint">Architecture studies and experiments are in the <a href="/research/">research journal</a>.</p>
    </section>

    <section class="block" aria-labelledby="notes-h">
      <h2 id="notes-h" class="eyebrow">Technical learning notes</h2>
      {noteGroups.map((g) => (
        <div class="group">
          <h3>{g}</h3>
          <EntryList items={notes.filter((n) => groupOf(n) === g).map(toItem)} />
        </div>
      ))}
    </section>
  </div>
</Base>

<style>
  .block { margin-top: var(--s-7); }
  .block > h2 { margin-bottom: var(--s-4); }
  .group { margin-top: var(--s-5); }
  .group h3 { font-size: var(--fs-base); font-weight: 600; margin-bottom: var(--s-3); }
  .hint { margin-top: var(--s-3); }
</style>
