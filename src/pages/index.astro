---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import EntryList from '../components/EntryList.astro';
import { SITE, readingTime } from '../lib/site';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const featured = projects.filter((p) => p.data.featured);

const research = (await getCollection('research', (e) => !e.data.draft)).map((e) => ({
  href: `/research/${e.id}/`,
  title: e.data.title,
  description: e.data.description,
  date: e.data.created,
  label: `${e.data.type} · ${e.data.status}`,
}));
const articles = (await getCollection('writing', (e) => !e.data.draft && e.data.kind === 'article')).map((e) => ({
  href: `/${e.data.slug}/`,
  title: e.data.title,
  description: e.data.description,
  date: e.data.created,
  label: e.data.topic,
  minutes: readingTime(e.body),
}));
const latest = [...research, ...articles].sort((a, b) => +b.date - +a.date).slice(0, 4);
const notesCount = (await getCollection('writing', (e) => e.data.kind === 'learning-note')).length;

const areas = [
  {
    n: '01',
    title: 'Agentic AI & Orchestration',
    body: 'Agents that act inside explicit boundaries: persisted state, deterministic triggers, isolated execution, independent review and human authorisation.',
    links: [{ href: '/projects/seerxo-os/', label: 'Seerxo OS' }, { href: '/research/deterministic-agent-triggers/', label: 'Deterministic triggers' }],
  },
  {
    n: '02',
    title: 'Backend & Infrastructure',
    body: 'APIs, PostgreSQL-backed services, containers and CI/CD — with recovery paths, backups and observability designed in rather than added later.',
    links: [{ href: '/projects/seerxo/', label: 'Seerxo API & clients' }, { href: '/projects/self-hosted-devops/', label: 'Self-hosted PaaS' }],
  },
  {
    n: '03',
    title: 'Security & Developer Tools',
    body: 'Small tools with a written threat model: fail-closed defaults, minimal dependencies, fuzzed parsers and documented limitations.',
    links: [{ href: '/projects/sigsieve/', label: 'SigSieve' }, { href: '/projects/bridge/', label: 'Bridge' }],
  },
  {
    n: '04',
    title: 'LLM Evaluation & Applied Research',
    body: 'Evidence-led investigations of agent reliability, tool-use boundaries and evaluation methods — with hypotheses separated from verified results.',
    links: [{ href: '/research/', label: 'Research journal' }, { href: '/research/ssh-agent-forwarding-threat-model/', label: 'SSH agent threat model' }],
  },
];
---

<Base>
  <section class="hero grid-bg" aria-labelledby="hero-title">
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <p class="eyebrow"><span class="idx">sezz.dev</span> AI Engineer · Agentic AI & LLM Systems</p>
        <h1 id="hero-title">Semih Buğra Sezer</h1>
        <p class="tagline">{SITE.tagline}</p>
        <p class="intro">
          I build agentic AI systems, LLM-powered developer tools and the backend infrastructure that
          makes them reliable. My work spans agent orchestration, MCP integrations, deterministic
          workflows and explicit security boundaries. B.Sc. Computer Engineering, Karabük University.
        </p>
        <div class="actions">
          <a class="btn primary" href="/ai-engineering/">Explore AI engineering <span class="arrow" aria-hidden="true">→</span></a>
          <a class="btn" href="/projects/">See engineering case studies</a>
          <a class="btn" href={SITE.github} rel="noopener" target="_blank">View GitHub</a>
        </div>
      </div>

      <aside class="spec" aria-label="Current engineering work">
        <p class="eyebrow">Selected systems · Oct 2026</p>
        <dl>
          {featured.map((p) => (
            <div class="spec-row">
              <dt><a href={`/projects/${p.id}/`}>{p.data.title}</a></dt>
              <dd>{p.data.status}</dd>
            </div>
          ))}
        </dl>
        <p class="meta spec-foot">Stack: Go · Python · TypeScript · Rust · PostgreSQL · Docker</p>
      </aside>
    </div>
  </section>

  <section class="section" aria-labelledby="focus-title">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow"><span class="idx">01</span> Areas of focus</p>
        <h2 id="focus-title">Where I spend engineering time</h2>
      </div>
      <ol class="areas">
        {areas.map((a) => (
          <li class="area">
            <span class="meta area-n">{a.n}</span>
            <h3>{a.title}</h3>
            <p>{a.body}</p>
            <ul class="area-links">
              {a.links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
            </ul>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section" aria-labelledby="work-title">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow"><span class="idx">02</span> Featured engineering work</p>
        <h2 id="work-title">Engineering evidence, not just a tech stack</h2>
        <p>Explore what I designed, why the tradeoffs matter, what the code demonstrates and where the work is not yet verified.</p>
      </div>
      <div class="featured">
        {featured.map((p, i) => <ProjectCard project={p} index={i + 1} large />)}
      </div>
      <p class="more-link"><a href="/ai-engineering/">How these projects demonstrate AI engineering →</a> · <a href="/projects/">All projects →</a></p>
    </div>
  </section>

  <section class="section" aria-labelledby="writing-title">
    <div class="wrap two-col">
      <div class="section-head">
        <p class="eyebrow"><span class="idx">03</span> Research & writing</p>
        <h2 id="writing-title">Latest notes</h2>
        <p>Architecture studies and engineering articles. {notesCount} shorter learning notes live in the <a href="/writing/">writing archive</a>.</p>
      </div>
      <EntryList items={latest} />
    </div>
  </section>

  <section class="section" aria-labelledby="now-title">
    <div class="wrap two-col">
      <div class="section-head">
        <p class="eyebrow"><span class="idx">04</span> Currently exploring</p>
        <h2 id="now-title">Open questions</h2>
        <p class="meta">As of 31 Oct 2026 · <a href="/now/">more on /now</a></p>
      </div>
      <ul class="exploring">
        <li><strong>Unattended agent work.</strong> What evidence is enough before an isolated coding agent runs without a human watching — in <a href="/projects/seerxo-os/">Seerxo OS</a>.</li>
        <li><strong>Destination-bound SSH keys.</strong> Making hardware-backed keys usable only for authentication to approved hosts — in <a href="/projects/sigsieve/">SigSieve</a>.</li>
        <li><strong>Agent-facing product surfaces.</strong> Tool schemas that stop agents overclaiming, and deterministic checks next to generation — in <a href="/projects/seerxo/">Seerxo</a>.</li>
      </ul>
    </div>
  </section>

  <section class="section" aria-labelledby="contact-title">
    <div class="wrap contact">
      <div class="section-head">
        <p class="eyebrow"><span class="idx">05</span> Contact & collaboration</p>
        <h2 id="contact-title">Let’s talk about systems</h2>
        <p>Open to AI Engineer, Applied AI Engineer and LLM / Agent Engineering roles, and collaboration on useful open-source AI infrastructure.</p>
      </div>
      <div class="actions">
        <a class="btn primary" href={SITE.linkedin} rel="noopener" target="_blank">LinkedIn <span class="arrow" aria-hidden="true">→</span></a>
        <a class="btn" href={SITE.github} rel="noopener" target="_blank">GitHub</a>
        <a class="btn" href="/contact/">All contact options</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .hero { border-bottom: 1px solid var(--rule); }
  .hero-grid { display: grid; gap: var(--s-7); padding-block: var(--s-9) var(--s-8); align-items: end; }
  @media (min-width: 60rem) { .hero-grid { grid-template-columns: minmax(0, 1.55fr) minmax(0, 1fr); } }
  .hero h1 {
    font-family: var(--font-display); font-weight: 500; font-size: var(--fs-hero);
    letter-spacing: -0.035em; line-height: 0.98; margin-block: var(--s-4) var(--s-5);
  }
  .tagline { font-family: var(--font-display); font-size: var(--fs-lg); line-height: 1.35; max-width: 30ch; color: var(--ink); font-style: italic; }
  .intro { margin-top: var(--s-4); color: var(--ink-2); max-width: 58ch; }
  .actions { display: flex; flex-wrap: wrap; gap: var(--s-3); margin-top: var(--s-6); }

  .spec { border: 1px solid var(--rule-strong); background: var(--bg-raised); border-radius: var(--radius); padding: var(--s-5); }
  .spec dl { margin-top: var(--s-3); }
  .spec-row { display: grid; gap: var(--s-1); padding-block: var(--s-3); border-top: 1px solid var(--rule); }
  .spec-row:first-child { border-top: 0; }
  .spec dt { font-weight: 600; }
  .spec dt a { text-decoration: none; }
  .spec dt a::after { content: ' →'; color: var(--ink-3); }
  .spec dd { font-family: var(--font-mono); font-size: var(--fs-xs); color: var(--ink-2); }
  .spec-foot { border-top: 1px solid var(--rule); padding-top: var(--s-3); }

  .areas { list-style: none; padding: 0; display: grid; gap: 0; grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr)); border-top: 1px solid var(--rule); border-left: 1px solid var(--rule); }
  .area { padding: var(--s-5); border-right: 1px solid var(--rule); border-bottom: 1px solid var(--rule); display: flex; flex-direction: column; gap: var(--s-2); }
  .area-n { color: var(--accent); }
  .area h3 { font-size: var(--fs-md); font-weight: 600; }
  .area p { color: var(--ink-2); font-size: var(--fs-sm); }
  .area-links { list-style: none; padding: 0; margin-top: auto; padding-top: var(--s-3); display: flex; flex-wrap: wrap; gap: var(--s-1) var(--s-4); font-size: var(--fs-sm); }

  .featured { display: grid; gap: var(--s-4); grid-template-columns: repeat(auto-fit, minmax(19rem, 1fr)); }
  .more-link { margin-top: var(--s-5); font-size: var(--fs-sm); }

  .two-col { display: grid; gap: var(--s-6); align-items: start; }
  @media (min-width: 60rem) { .two-col { grid-template-columns: minmax(0, 1fr) minmax(0, 2fr); } }
  .exploring { list-style: none; padding: 0; display: grid; gap: var(--s-4); }
  .exploring li { padding-left: var(--s-5); border-left: 1px solid var(--rule-strong); color: var(--ink-2); }
  .exploring strong { color: var(--ink); font-weight: 600; }
  .contact .actions { margin-top: 0; }
</style>
