---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import EntryList from '../../components/EntryList.astro';

const entries = (await getCollection('research', (e) => !e.data.draft)).sort((a, b) => +b.data.created - +a.data.created);
const items = entries.map((e) => ({
  href: `/research/${e.id}/`,
  title: e.data.title,
  description: e.data.description,
  date: e.data.created,
  label: `${e.data.type} · ${e.data.status}`,
}));
---

<Base title="Research" description="An independent engineering research journal: agent orchestration, operational memory, AI safety boundaries, SSH security and secure delivery — with method, evidence and limitations.">
  <header class="wrap page-head">
    <p class="eyebrow">Research journal</p>
    <h1>Independent engineering research</h1>
    <p class="lede">
      Technical investigations that come out of building real systems. Each entry states its question,
      method, evidence and limitations, and is labelled by what it is.
    </p>
  </header>

  <div class="wrap body">
    <div class="legend">
      <dl>
        <div><dt>Architecture Study</dt><dd>How and why a system is structured; tradeoffs made.</dd></div>
        <div><dt>Research Experiment</dt><dd>A structured test with a method and recorded results.</dd></div>
        <div><dt>Engineering Note</dt><dd>A short observation from implementation work.</dd></div>
        <div><dt>Build Log</dt><dd>Progress and lessons from developing a system.</dd></div>
      </dl>
      <p class="notice">
        <strong>Scope.</strong> This is independent technical investigation, not academic research. Nothing here is
        peer-reviewed. Status labels — <em>Hypothesis</em>, <em>In progress</em>, <em>Observation</em>,
        <em>Concluded</em> — say how much weight an entry can bear.
      </p>
    </div>
    <EntryList items={items} />
    <section class="themes" aria-labelledby="themes-h">
      <h2 id="themes-h" class="eyebrow">Themes under investigation</h2>
      <ul class="chips">
        {['Agent orchestration & autonomy', 'LLM reliability & evaluation', 'Operational memory', 'AI safety boundaries', 'Deterministic workflows', 'Secure software delivery', 'SSH security & access control', 'CI/CD reliability'].map((t) => <li class="chip">{t}</li>)}
      </ul>
    </section>
  </div>
</Base>

<style>
  .body { display: grid; gap: var(--s-6); padding-top: var(--s-6); }
  .legend { display: grid; gap: var(--s-4); }
  .legend dl { display: grid; gap: var(--s-3); grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr)); }
  .legend dt { font-weight: 600; font-size: var(--fs-sm); }
  .legend dd { font-size: var(--fs-sm); color: var(--ink-2); }
  .themes .chips { margin-top: var(--s-3); }
</style>
