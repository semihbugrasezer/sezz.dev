---
import Base from '../layouts/Base.astro';
import { SITE } from '../lib/site';
import { getLang, localize, type Lang } from '../lib/i18n';

const lang = getLang(Astro.url);
const copy = {
  en: {
    title: 'Contact', description: 'How to reach Semih Buğra Sezer: email, LinkedIn and GitHub.', h1: 'Get in touch',
    lede: 'For AI Engineer, Applied AI Engineer and LLM / Agent Engineering roles, open-source collaboration, or questions about the systems documented here.',
    em: 'Email', emD: 'The most direct way to reach me about roles.',
    li: 'Professional profile and messages.', gh: 'Issues and discussions on the projects themselves.',
    sec: 'Security reports', secV: 'Per-repository security policy', secD: 'Please follow each project’s SECURITY.md rather than opening a public issue.',
    recruitersTitle: 'For recruiters and hiring managers',
    recruitersBody: 'Links you can paste into an application or a hiring note. Case studies are in English.',
    linkLabels: ['Email', 'Portfolio', 'AI engineering evidence', 'Acthelm — agentic AI case study', 'Seerxo — LLM product case study', 'SigSieve — security engineering case study', 'GitHub', 'LinkedIn'],
  },
  tr: {
    title: 'İletişim', description: 'Semih Buğra Sezer’e ulaşmanın yolları: e-posta, LinkedIn ve GitHub.', h1: 'İletişime geçin',
    lede: 'AI Engineer, Applied AI Engineer ve LLM / Agent Engineering pozisyonları, açık kaynak iş birlikleri veya burada anlatılan sistemlerle ilgili sorularınız için.',
    em: 'E-posta', emD: 'Pozisyonlar için bana ulaşmanın en doğrudan yolu.',
    li: 'Profesyonel profil ve mesajlar.', gh: 'Projelerle ilgili issue ve tartışmalar için.',
    sec: 'Güvenlik bildirimleri', secV: 'Depo bazında güvenlik politikası', secD: 'Lütfen herkese açık issue açmak yerine her projenin SECURITY.md dosyasını izleyin.',
    recruitersTitle: 'İşe alım uzmanları ve yöneticiler için',
    recruitersBody: 'Bir başvuruya veya değerlendirme notuna yapıştırabileceğiniz bağlantılar. Vaka çalışmaları İngilizcedir.',
    linkLabels: ['E-posta', 'Portföy', 'AI mühendisliği kanıtları', 'Acthelm — agentic AI vaka çalışması', 'Seerxo — LLM ürünü vaka çalışması', 'SigSieve — güvenlik mühendisliği vaka çalışması', 'GitHub', 'LinkedIn'],
  },
  de: {
    title: 'Kontakt', description: 'So erreichen Sie Semih Buğra Sezer: E-Mail, LinkedIn und GitHub.', h1: 'Kontakt aufnehmen',
    lede: 'Für Rollen als AI Engineer, Applied AI Engineer und LLM-/Agent-Engineer, Open-Source-Zusammenarbeit oder Fragen zu den hier dokumentierten Systemen.',
    em: 'E-Mail', emD: 'Der direkteste Weg, mich wegen einer Stelle zu erreichen.',
    li: 'Berufliches Profil und Nachrichten.', gh: 'Issues und Diskussionen zu den Projekten selbst.',
    sec: 'Sicherheitsmeldungen', secV: 'Security-Policy je Repository', secD: 'Bitte folgen Sie der SECURITY.md des jeweiligen Projekts, statt ein öffentliches Issue zu eröffnen.',
    recruitersTitle: 'Für Recruiter und Hiring Manager',
    recruitersBody: 'Links zum Einfügen in eine Bewerbung oder Einschätzung. Die Fallstudien sind auf Englisch.',
    linkLabels: ['E-Mail', 'Portfolio', 'Belege zum AI Engineering', 'Acthelm — Fallstudie Agentic AI', 'Seerxo — Fallstudie LLM-Produkt', 'SigSieve — Fallstudie Security-Engineering', 'GitHub', 'LinkedIn'],
  },
} satisfies Record<Lang, unknown>;
const c = copy[lang];
const abs = (path: string) => `https://sezz.dev${path}`;
const recruiterLinks = [
  `mailto:${SITE.email}`, abs(localize('/', lang)), abs(localize('/ai-engineering/', lang)), abs('/projects/acthelm/'), abs('/projects/seerxo/'),
  abs('/projects/sigsieve/'), SITE.github, SITE.linkedin,
].map((href, i) => ({ href, label: c.linkLabels[i] }));
---

<Base title={c.title} description={c.description}>
  <header class="wrap page-head">
    <p class="eyebrow">{c.title}</p>
    <h1>{c.h1}</h1>
    <p class="lede">{c.lede}</p>
  </header>

  <div class="wrap">
    <ul class="channels">
      <li>
        <a href={`mailto:${SITE.email}`}>
          <span class="eyebrow">{c.em}</span>
          <span class="v">{SITE.email}</span>
          <span class="d">{c.emD}</span>
        </a>
      </li>
      <li>
        <a href={SITE.linkedin} rel="me noopener" target="_blank">
          <span class="eyebrow">LinkedIn</span>
          <span class="v">linkedin.com/in/semihbugrasezer</span>
          <span class="d">{c.li}</span>
        </a>
      </li>
      <li>
        <a href={SITE.github} rel="me noopener" target="_blank">
          <span class="eyebrow">GitHub</span>
          <span class="v">github.com/semihbugrasezer</span>
          <span class="d">{c.gh}</span>
        </a>
      </li>
      <li>
        <a href="https://github.com/semihbugrasezer/sigsieve/security" rel="noopener" target="_blank">
          <span class="eyebrow">{c.sec}</span>
          <span class="v">{c.secV}</span>
          <span class="d">{c.secD}</span>
        </a>
      </li>
    </ul>

    <section class="recruiters" aria-labelledby="recruiters-h">
      <h2 id="recruiters-h">{c.recruitersTitle}</h2>
      <p>{c.recruitersBody}</p>
      <dl>
        {recruiterLinks.map((l) => (
          <div><dt>{l.label}</dt><dd><a href={l.href} {...(l.href.startsWith('http') && !l.href.startsWith('https://sezz.dev') ? { rel: 'noopener', target: '_blank' } : {})}>{l.href.replace(/^mailto:/, '')}</a></dd></div>
        ))}
      </dl>
    </section>
  </div>
</Base>

<style>
  .channels { list-style: none; padding: 0; display: grid; gap: var(--s-4); grid-template-columns: repeat(auto-fit, minmax(min(100%, 17rem), 1fr)); margin-top: var(--s-6); }
  .channels a {
    display: grid; gap: var(--s-2); height: 100%; padding: var(--s-5); text-decoration: none;
    border: 1px solid var(--rule); border-radius: var(--radius); background: var(--bg-raised);
  }
  .channels a:hover { border-color: var(--ink-3); color: inherit; }
  .v { font-weight: 600; font-size: var(--fs-md); word-break: break-word; }
  .d { color: var(--ink-2); font-size: var(--fs-sm); }
  .recruiters { margin-top: var(--s-7); border-top: 1px solid var(--rule); padding-top: var(--s-6); max-width: 52rem; }
  .recruiters h2 { font-family: var(--font-display); font-weight: 550; font-size: var(--fs-lg); }
  .recruiters > p { color: var(--ink-2); margin-top: var(--s-2); }
  .recruiters dl { margin-block: var(--s-4); border-top: 1px solid var(--rule); }
  .recruiters dl > div { display: grid; grid-template-columns: 17rem 1fr; gap: var(--s-1) var(--s-4); padding-block: var(--s-2); border-bottom: 1px solid var(--rule); font-size: var(--fs-sm); }
  .recruiters dt { font-weight: 600; }
  .recruiters dd a { font-family: var(--font-mono); font-size: 0.8rem; overflow-wrap: anywhere; }
  @media (max-width: 44rem) { .recruiters dl > div { grid-template-columns: 1fr; } }
</style>
