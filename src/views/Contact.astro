---
import Base from '../layouts/Base.astro';
import { SITE } from '../lib/site';
import { getLang, type Lang } from '../lib/i18n';

const lang = getLang(Astro.url);
const copy = {
  en: {
    title: 'Contact', description: 'How to reach Semih Buğra Sezer: GitHub and LinkedIn.', h1: 'Get in touch',
    lede: 'For AI Engineer, Applied AI Engineer and LLM / Agent Engineering roles, open-source collaboration, or questions about the systems documented here.',
    li: 'Best for roles and professional enquiries.', gh: 'Issues and discussions on the projects themselves.',
    sec: 'Security reports', secV: 'Per-repository security policy', secD: 'Please follow each project’s SECURITY.md rather than opening a public issue.',
  },
  tr: {
    title: 'İletişim', description: 'Semih Buğra Sezer’e ulaşmanın yolları: GitHub ve LinkedIn.', h1: 'İletişime geçin',
    lede: 'AI Engineer, Applied AI Engineer ve LLM / Agent Engineering pozisyonları, açık kaynak iş birlikleri veya burada anlatılan sistemlerle ilgili sorularınız için.',
    li: 'Pozisyonlar ve profesyonel talepler için en uygun kanal.', gh: 'Projelerle ilgili issue ve tartışmalar için.',
    sec: 'Güvenlik bildirimleri', secV: 'Depo bazında güvenlik politikası', secD: 'Lütfen herkese açık issue açmak yerine her projenin SECURITY.md dosyasını izleyin.',
  },
  de: {
    title: 'Kontakt', description: 'So erreichen Sie Semih Buğra Sezer: GitHub und LinkedIn.', h1: 'Kontakt aufnehmen',
    lede: 'Für Rollen als AI Engineer, Applied AI Engineer und LLM-/Agent-Engineer, Open-Source-Zusammenarbeit oder Fragen zu den hier dokumentierten Systemen.',
    li: 'Am besten für Stellenangebote und berufliche Anfragen.', gh: 'Issues und Diskussionen zu den Projekten selbst.',
    sec: 'Sicherheitsmeldungen', secV: 'Security-Policy je Repository', secD: 'Bitte folgen Sie der SECURITY.md des jeweiligen Projekts, statt ein öffentliches Issue zu eröffnen.',
  },
} satisfies Record<Lang, unknown>;
const c = copy[lang];
---

<Base title={c.title} description={c.description}>
  <header class="wrap page-head">
    <p class="eyebrow">{c.title}</p>
    <h1>{c.h1}</h1>
    <p class="lede">{c.lede}</p>
  </header>

  <div class="wrap">
    <ul class="channels">
      <li>
        <a href={SITE.linkedin} rel="me noopener" target="_blank">
          <span class="eyebrow">LinkedIn</span>
          <span class="v">linkedin.com/in/semihbugrasezer</span>
          <span class="d">{c.li}</span>
        </a>
      </li>
      <li>
        <a href={SITE.github} rel="me noopener" target="_blank">
          <span class="eyebrow">GitHub</span>
          <span class="v">github.com/semihbugrasezer</span>
          <span class="d">{c.gh}</span>
        </a>
      </li>
      <li>
        <a href="https://github.com/semihbugrasezer/sigsieve/security" rel="noopener" target="_blank">
          <span class="eyebrow">{c.sec}</span>
          <span class="v">{c.secV}</span>
          <span class="d">{c.secD}</span>
        </a>
      </li>
    </ul>
  </div>
</Base>

<style>
  .channels { list-style: none; padding: 0; display: grid; gap: var(--s-4); grid-template-columns: repeat(auto-fit, minmax(min(100%, 17rem), 1fr)); margin-top: var(--s-6); }
  .channels a {
    display: grid; gap: var(--s-2); height: 100%; padding: var(--s-5); text-decoration: none;
    border: 1px solid var(--rule); border-radius: var(--radius); background: var(--bg-raised);
  }
  .channels a:hover { border-color: var(--ink-3); color: inherit; }
  .v { font-weight: 600; font-size: var(--fs-md); word-break: break-word; }
  .d { color: var(--ink-2); font-size: var(--fs-sm); }
</style>
