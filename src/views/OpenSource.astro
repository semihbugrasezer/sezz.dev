---
import Base from '../layouts/Base.astro';
import { getLang, type Lang } from '../lib/i18n';

const lang = getLang(Astro.url);

const GH = 'https://github.com';
// Facts per tool are language-independent; descriptions are translated below.
const tools = [
  {
    name: 'SigSieve', licence: 'MIT', repo: `${GH}/semihbugrasezer/sigsieve`, open: true,
    install: 'brew install semihbugrasezer/sigsieve/sigsieve',
    docs: `${GH}/semihbugrasezer/sigsieve/blob/main/docs/INSTALL.md`, issues: `${GH}/semihbugrasezer/sigsieve/issues/new/choose`,
    security: `${GH}/semihbugrasezer/sigsieve/blob/main/SECURITY.md`, contribute: `${GH}/semihbugrasezer/sigsieve/blob/main/CONTRIBUTING.md`,
    caseStudy: '/projects/sigsieve/',
  },
  {
    name: 'Seerxo CLI & MCP server', licence: 'MIT', repo: `${GH}/semihbugrasezer/seerxo`, open: true,
    install: 'npm install -g seerxo && seerxo login',
    docs: `${GH}/semihbugrasezer/seerxo#readme`, issues: `${GH}/semihbugrasezer/seerxo/issues`,
    security: `${GH}/semihbugrasezer/seerxo/blob/main/SECURITY.md`, contribute: null,
    caseStudy: '/projects/seerxo/',
  },
  {
    name: 'Bridge', licence: 'Apache-2.0', repo: `${GH}/Seerxo/bridge`, open: true,
    install: 'npx seerxo-bridge',
    docs: `${GH}/Seerxo/bridge#readme`, issues: `${GH}/Seerxo/bridge/issues`,
    security: `${GH}/Seerxo/bridge/blob/main/SECURITY.md`, contribute: null,
    caseStudy: '/projects/bridge/',
  },
  {
    name: 'Acthelm', licence: null, repo: `${GH}/Seerxo/Acthelm`, open: false,
    install: null,
    docs: `${GH}/Seerxo/Acthelm#readme`, issues: `${GH}/Seerxo/Acthelm/issues`,
    security: `${GH}/Seerxo/Acthelm/blob/main/SECURITY.md`, contribute: `${GH}/Seerxo/Acthelm/blob/main/CONTRIBUTING.md`,
    caseStudy: '/projects/acthelm/',
  },
];

const copy = {
  en: {
    title: 'Open Source & Community Contributions',
    description: 'Open-source tools by Semih Buğra Sezer: what each one helps with, how to use it, where to report problems, and its limits.',
    eyebrow: 'Open source & community',
    h1: 'Open source & community contributions',
    lede: 'Software I publish so other developers can use, inspect and improve it. Each entry says what it is for, how to start, where to report problems and what it does not do. Public source and an open-source licence are not the same thing; the licence is stated for each.',
    labels: { licence: 'Licence', install: 'Get started', docs: 'Documentation', issues: 'Report a bug', security: 'Security issues', contribute: 'Contributing', limits: 'Limits', caseStudy: 'Case study' },
    noLicence: 'No licence yet — public to read, all rights reserved',
    contributeNone: 'Bug reports and questions via issues',
    contributeOsNote: 'See the contribution guide; reuse and distribution rights have not yet been licensed',
    readGuide: 'Contribution guide',
    items: [
      { what: 'Forwards selected identities from an existing SSH agent, with optional destination binding. Alpha.4 has macOS arm64 and Linux x86_64 downloads with checksums and provenance; the macOS Homebrew tap builds from source. No account or telemetry.', limits: 'Experimental alpha.4, not independently audited. Homebrew tested on Apple Silicon only. Secretive/Touch ID behavior has not been reverified for alpha.4; an allowed key can still be misused while forwarding is active.' },
      { what: 'Drafts, audits and optimises Etsy listings from a terminal, Claude Desktop, Claude Code or any MCP client. The audit is free and rule-based.', limits: 'The open-source part is the client; generation runs on the hosted Seerxo service and needs an account.' },
      { what: 'Lets AI coding agents that speak the Anthropic Messages API run against OpenAI-compatible providers, including streaming and tool calls.', limits: 'Early compatibility layer: images, prompt caching and extended thinking are not translated yet.' },
      { what: 'A reference design for running AI agents inside explicit boundaries: persisted state, deterministic triggers, isolated execution and signed releases. Useful to read; not yet licensed for reuse.', limits: 'Single host, one company, no licence. Unattended code changes are off by default.' },
    ],
  },
  tr: {
    title: 'Açık Kaynak ve Topluluk Katkıları',
    description: 'Semih Buğra Sezer’in açık kaynak araçları: her birinin ne işe yaradığı, nasıl kullanıldığı, sorunların nereye bildirileceği ve sınırları.',
    eyebrow: 'Açık kaynak ve topluluk',
    h1: 'Açık kaynak ve topluluk katkıları',
    lede: 'Diğer geliştiricilerin kullanabilmesi, inceleyebilmesi ve geliştirebilmesi için yayımladığım yazılımlar. Her kayıt ne işe yaradığını, nasıl başlanacağını, sorunların nereye bildirileceğini ve neyi yapmadığını söylüyor. Kaynak kodun herkese açık olması ile açık kaynak lisansı aynı şey değildir; her birinin lisansı belirtilmiştir.',
    labels: { licence: 'Lisans', install: 'Başlarken', docs: 'Dokümantasyon', issues: 'Hata bildir', security: 'Güvenlik açıkları', contribute: 'Katkı', limits: 'Sınırlar', caseStudy: 'Vaka çalışması' },
    noLicence: 'Henüz lisans yok — okunabilir, tüm hakları saklıdır',
    contributeNone: 'Hata bildirimleri ve sorular issue üzerinden',
    contributeOsNote: 'Katkı rehberini inceleyin; yeniden kullanım ve dağıtım hakları henüz lisanslanmadı',
    readGuide: 'Katkı rehberi',
    items: [
      { what: 'Mevcut SSH agent’ınızdan seçtiğiniz kimlikleri iletir; isteğe bağlı hedef kısıtlaması sunar. Alpha.4 için checksum ve provenance ile macOS arm64 ve Linux x86_64 indirmeleri var; macOS Homebrew tap’i kaynak koddan derler. Hesap veya telemetri yok.', limits: 'Deneysel alpha.4; bağımsız denetimden geçmedi. Homebrew yalnızca Apple Silicon’da test edildi. Secretive/Touch ID davranışı alpha.4 için yeniden doğrulanmadı; yönlendirme açıkken izin verilen bir anahtar kötüye kullanılabilir.' },
      { what: 'Etsy ilanlarını terminalden, Claude Desktop’tan, Claude Code’dan veya herhangi bir MCP istemcisinden hazırlar, denetler ve iyileştirir. Denetim ücretsiz ve kural tabanlıdır.', limits: 'Açık kaynak olan kısım istemcidir; üretim, barındırılan Seerxo servisinde çalışır ve hesap gerektirir.' },
      { what: 'Anthropic Messages API kullanan AI kodlama ajanlarının, streaming ve tool call’lar dahil, OpenAI uyumlu sağlayıcılarla çalışmasını sağlar.', limits: 'Erken uyumluluk katmanı: görseller, prompt caching ve extended thinking henüz çevrilmiyor.' },
      { what: 'AI ajanlarını açık sınırlar içinde çalıştırmak için bir referans tasarım: kalıcı durum, deterministik tetikleyiciler, izole çalıştırma ve imzalı sürümler. Okumak için faydalı; yeniden kullanım için henüz lisanslı değil.', limits: 'Tek sunucu, tek şirket, lisans yok. Gözetimsiz kod değişiklikleri varsayılan olarak kapalı.' },
    ],
  },
  de: {
    title: 'Open Source & Community-Beiträge',
    description: 'Open-Source-Werkzeuge von Semih Buğra Sezer: wofür sie gut sind, wie man sie nutzt, wo man Probleme meldet und wo ihre Grenzen liegen.',
    eyebrow: 'Open Source & Community',
    h1: 'Open Source & Community-Beiträge',
    lede: 'Software, die ich veröffentliche, damit andere Entwickler sie nutzen, prüfen und verbessern können. Jeder Eintrag sagt, wofür sie da ist, wie man startet, wo man Probleme meldet und was sie nicht kann. Öffentlicher Quellcode und eine Open-Source-Lizenz sind nicht dasselbe; die Lizenz steht jeweils dabei.',
    labels: { licence: 'Lizenz', install: 'Erste Schritte', docs: 'Dokumentation', issues: 'Fehler melden', security: 'Sicherheitsprobleme', contribute: 'Mitwirken', limits: 'Grenzen', caseStudy: 'Fallstudie' },
    noLicence: 'Noch keine Lizenz — öffentlich lesbar, alle Rechte vorbehalten',
    contributeNone: 'Fehlerberichte und Fragen über Issues',
    contributeOsNote: 'Bitte den Beitragsleitfaden lesen; Rechte zur Weiterverwendung und Verteilung sind noch nicht lizenziert',
    readGuide: 'Leitfaden für Beiträge',
    items: [
      { what: 'Leitet ausgewählte Identitäten eines vorhandenen SSH-Agenten weiter, optional an Ziel-Hostkeys gebunden. Alpha.4 bietet Downloads für macOS arm64 und Linux x86_64 mit Prüfsummen und Provenienz; der macOS-Homebrew-Tap baut aus dem Quellcode. Kein Konto und keine Telemetrie.', limits: 'Experimentelle alpha.4, nicht unabhängig auditiert. Homebrew nur auf Apple Silicon getestet. Secretive/Touch ID wurde für alpha.4 nicht erneut verifiziert; erlaubte Schlüssel können während der Weiterleitung weiterhin missbraucht werden.' },
      { what: 'Entwirft, prüft und optimiert Etsy-Listings aus dem Terminal, Claude Desktop, Claude Code oder jedem MCP-Client. Die Prüfung ist kostenlos und regelbasiert.', limits: 'Open Source ist der Client; die Generierung läuft auf dem gehosteten Seerxo-Dienst und erfordert ein Konto.' },
      { what: 'Lässt KI-Coding-Agenten, die die Anthropic Messages API sprechen, mit OpenAI-kompatiblen Anbietern arbeiten – inklusive Streaming und Tool-Calls.', limits: 'Frühe Kompatibilitätsschicht: Bilder, Prompt Caching und Extended Thinking werden noch nicht übersetzt.' },
      { what: 'Ein Referenzdesign für KI-Agenten innerhalb klarer Grenzen: persistenter Zustand, deterministische Auslöser, isolierte Ausführung und signierte Releases. Lesenswert, aber noch nicht zur Weiterverwendung lizenziert.', limits: 'Ein Host, ein Unternehmen, keine Lizenz. Unbeaufsichtigte Codeänderungen sind standardmäßig aus.' },
    ],
  },
} satisfies Record<Lang, unknown>;
const c = copy[lang];
const en = lang !== 'en';
---

<Base title={c.title} description={c.description}>
  <header class="wrap page-head">
    <p class="eyebrow">{c.eyebrow}</p>
    <h1>{c.h1}</h1>
    <p class="lede">{c.lede}</p>
  </header>

  <div class="wrap list">
    {tools.map((tool, i) => (
      <article class="tool" aria-labelledby={`tool-${i}`}>
        <header class="tool-head">
          <h2 id={`tool-${i}`}><a href={tool.repo} rel="noopener" target="_blank">{tool.name}</a></h2>
          <span class:list={['licence', { none: !tool.open }]}>{tool.licence ?? c.noLicence}</span>
        </header>
        <p class="what">{c.items[i].what}</p>
        <dl>
          {tool.install && (
            <div><dt>{c.labels.install}</dt><dd><code>{tool.install}</code></dd></div>
          )}
          <div><dt>{c.labels.docs}</dt><dd><a href={tool.docs} rel="noopener" target="_blank">README / docs</a></dd></div>
          <div>
            <dt>{c.labels.issues}</dt>
            <dd><a href={tool.issues} rel="noopener" target="_blank">GitHub Issues</a> · <a href={tool.security} rel="noopener" target="_blank">{c.labels.security}: SECURITY.md</a></dd>
          </div>
          <div>
            <dt>{c.labels.contribute}</dt>
            <dd>
              {tool.open ? (tool.contribute ? <a href={tool.contribute} rel="noopener" target="_blank">{c.readGuide}</a> : c.contributeNone) : <>{c.contributeOsNote} · <a href={tool.contribute!} rel="noopener" target="_blank">CONTRIBUTING.md</a></>}
            </dd>
          </div>
          <div><dt>{c.labels.limits}</dt><dd>{c.items[i].limits}</dd></div>
          <div><dt>{c.labels.caseStudy}</dt><dd><a href={tool.caseStudy}>{tool.name}{en && <abbr class="en" title="English">EN</abbr>} →</a></dd></div>
        </dl>
      </article>
    ))}
  </div>
</Base>

<style>
  .list { display: grid; gap: var(--s-5); padding-top: var(--s-6); }
  .tool { border: 1px solid var(--rule); border-radius: var(--radius); background: var(--bg-raised); padding: var(--s-5); display: grid; gap: var(--s-3); }
  .tool-head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: var(--s-2) var(--s-4); }
  .tool h2 { font-family: var(--font-display); font-weight: 550; font-size: var(--fs-lg); }
  .tool h2 a { text-decoration: none; }
  .licence { font-family: var(--font-mono); font-size: var(--fs-xs); border: 1px solid var(--ink); border-radius: 2px; padding: 0.1rem 0.5rem; }
  .licence.none { border-style: dashed; border-color: var(--rule-strong); color: var(--ink-3); }
  .what { color: var(--ink-2); max-width: 70ch; }
  dl { display: grid; gap: 0; border-top: 1px solid var(--rule); }
  dl > div { display: grid; grid-template-columns: 10rem 1fr; gap: var(--s-1) var(--s-4); padding-block: var(--s-2); border-bottom: 1px solid var(--rule); font-size: var(--fs-sm); }
  dl > div:last-child { border-bottom: 0; }
  dt { font-family: var(--font-mono); font-size: var(--fs-xs); text-transform: uppercase; letter-spacing: 0.06em; color: var(--ink-3); padding-top: 0.15rem; }
  dd code { font-family: var(--font-mono); font-size: 0.8rem; background: var(--code-bg); border: 1px solid var(--rule); border-radius: 3px; padding: 0.1em 0.35em; overflow-wrap: anywhere; }
  @media (max-width: 40rem) { dl > div { grid-template-columns: 1fr; } }
</style>
