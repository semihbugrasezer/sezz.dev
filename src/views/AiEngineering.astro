      ['Prompt Injection', 'partial', 'Kodierungs- und Eskalationsszenarien sind getestet; das belegt keine Injection-Resistenz echter Modelle', 'evals/test_trust_evals.py'],
      ['Sicherheitsgrenzen', 'ci', 'Tripwire-Tests für CI-Berechtigungen und Zugangsdaten', 'tests/test_trust_boundary.py'],
      ['Wiederherstellung von Agenten', 'ci', 'Crash- und Stale-Run-Recovery gegen echtes PostgreSQL', 'tests/test_worker_crash_recovery_postgres.py'],
      ['Regressionsszenarien', 'ci', 'Stage-C-Golden-Szenarien, die jeweils den abgefangenen Fehler benennen', 'evals/test_stage_c_runner_evals.py'],
      ['Tool-Verträge (MCP)', 'ci', 'stdio-MCP-Server in Seerxo End-to-End getestet', 'sx:tests/stdio-mcp.test.js'],
      ['Aufgaben-Erfolgsquote', 'planned', '—', ''],
      ['Tool-Call-Genauigkeit auf Modellebene', 'planned', '—', ''],
      ['Latenz pro Aufgabe', 'planned', '—', ''],
      ['Kosten pro Aufgabe', 'planned', 'Nur als Richtlinie: kostenpflichtige API-Schlüssel werden abgelehnt', 'agents/cost_policy.yaml'],
    ],
    harnessTitle: 'Erforderliche Belege für Modell-Benchmarks',
    harnessBody: 'Die deterministischen Tests oben prüfen das Verhalten der Steuerungsschicht. Ein Modell-Benchmark benötigt zusätzliche Belege; dies ist eine Evaluierungsmethode, keine zugesagte Produkt-Roadmap:',
    harnessSteps: ['Eine versionierte Aufgabensammlung mit festen Eingaben und vom Supervisor prüfbaren Erfolgskriterien', 'Jeder Lauf mit Anbieter, Modellversion, Transkript, Tool-Calls und Ergebnis protokolliert', 'Metriken je Sammlungsversion: Erfolg, Teilerfolg, falsche Freigaben, Wiederherstellungen, Latenz und Ressourcenverbrauch', 'Ein CI-Job, der den deterministischen Teil bei jeder Änderung und den Modellteil auf Abruf ausführt und Rohdaten veröffentlicht'],
    roadmap: 'Evaluierungs-Roadmap', roadmapTitle: 'Fragen, die meine Systeme beantworten sollen',
    roadmapBody: 'Das sind Evaluierungsfragen, <strong>keine veröffentlichten Benchmark-Ergebnisse</strong>. Ein belastbares Ergebnis braucht definierte Aufgaben, eine Methodik und Rohdaten.',
    toRun: 'geplantes Experiment',
    questions: [
      ['Erledigt ein Agent Aufgaben zuverlässig?', 'Eine versionierte, wiederholbare Aufgabensammlung erstellen. Erfolg, Teilerfolg und Fehlschläge mit Testbedingungen und Stichprobengröße berichten.'],
      ['Wann hilft ein Review durch mehrere Agenten?', 'Eine Ein-Agenten-Baseline mit Coder-plus-Reviewer-Workflows auf denselben Aufgaben vergleichen. Meinungsverschiedenheiten und falsche Freigaben erfassen.'],
      ['Was passiert, wenn Tools ausfallen?', 'Timeouts, ungültige Tool-Ausgaben, veralteten Zustand und abgebrochene Läufe einspeisen. Wiederherstellung messen und festhalten, wo ein Mensch eingreifen muss.'],
      ['Was kostet Autonomie?', 'Latenz, Token-/API-Nutzung (sofern zutreffend) und Ressourcenkosten pro abgeschlossener Aufgabe messen; Abonnements nicht mit Preisen pro Token verwechseln.'],
    ],
    notClaimed: '<strong>Derzeit nicht beansprucht:</strong> ein belegter RAG-Benchmark, ein selbst trainiertes Foundation Model, unabhängig auditierte Agenten-Sicherheit oder gemessener autonomer Aufgabenerfolg auf Produktionsniveau. Dafür braucht es eigene Belege.',
    community: 'Öffentliche Arbeit & Community', communityTitle: 'Offen entwickeln, Arbeit nützlich machen',
    communityBody: 'Wiederverwendbarer Code, technische Dokumentation und transparente Grenzen gehören zur Arbeit. SigSieve und der Seerxo-Client sind öffentlich und MIT-lizenziert; der Quellcode von Acthelm ist öffentlich, hat aber derzeit keine Open-Source-Lizenz. Der Unterschied ist wichtig.',
    links: [['SigSieve', 'Sicherheitsmodell, Grenzen, Installation und Quellcode →'], ['Seerxo', 'MCP-Tools, CLI-Dokumentation und Quellcode →'], ['Technische Recherche', 'Architekturstudien mit Belegen und Grenzen (Englisch) →']],
    smallPrint: 'Sicherheitsprobleme bitte über die Security-Policy des jeweiligen Repositorys melden, nicht über öffentliche Issues.',
    closingTitle: 'Interesse an einer Zusammenarbeit?',
    closingBody: 'Ich suche Rollen als AI Engineer, Applied AI Engineer und LLM-/Agent-Engineer. Meine stärksten Belege liegen in Agentensystemen, Entwickler-Tools und Backend-Infrastruktur.',
    contactMe: 'Kontakt aufnehmen →', background: 'Werdegang & Erfahrung',
  },
} satisfies Record<Lang, unknown>;
const c = copy[lang];
const OS = 'https://github.com/Seerxo/Acthelm/blob/b8b7e770c4508f2e2f9f86f08bb43b6e82528b16/';
const SX = 'https://github.com/semihbugrasezer/seerxo/blob/8c529841efc37ebb999500bd1b7e5bbfaba9e985/';
const SS = 'https://github.com/semihbugrasezer/sigsieve/blob/5ea37b73ce7ed5dd33f3ac405c3ae4ad4da68751/';
const codeBase: Record<string, string> = { 'Acthelm': OS, Seerxo: SX, SigSieve: SS };
const evHref = (path: string) => (path.startsWith('sx:') ? SX + path.slice(3) : OS + path);
const statusLabel = { ci: c.stCI, partial: c.stPartial, planned: c.stPlanned } as Record<string, string>;
const systems = c.systems.map((sys, i) => ({ ...sys, ...sources[i], number: String(i + 1).padStart(2, '0') }));
const communityHrefs = ['https://github.com/semihbugrasezer/sigsieve', 'https://github.com/semihbugrasezer/seerxo', L('/research/')];
---

<Base title={c.title} description={c.description}>
  <header class="wrap page-head">
    <p class="eyebrow">{c.eyebrow}</p>
    <h1>{c.h1}</h1>
    <p class="lede">{c.lede}</p>
    <div class="actions">
      <a class="btn primary" href="#engineering-evidence">{c.ctaEvidence}</a>
      <a class="btn" href={L('/projects/')}>{c.ctaProjects}</a>
      <a class="btn" href={L('/contact/')}>{c.ctaRole}</a>
    </div>
  </header>

  <div class="wrap content">
    <section class="principles" aria-labelledby="approach-heading">
      <div class="section-head">
        <p class="eyebrow">{c.approach}</p>
        <h2 id="approach-heading">{c.approachTitle}</h2>
      </div>
      <div class="principle-grid">
        {c.principles.map(([h, body]) => (
          <article>
            <h3>{h}</h3>
            <p>{body}</p>
          </article>
        ))}
      </div>
    </section>

    <section id="engineering-evidence" class="evidence" aria-labelledby="evidence-heading">
      <div class="section-head">
        <p class="eyebrow">{c.selected}</p>
        <h2 id="evidence-heading">{c.evidenceTitle}</h2>
        <p>{c.evidenceBody}</p>
      </div>
      <div class="system-grid">
        {systems.map((item) => (
          <article class="system">
            <div class="system-top"><span class="meta">{item.number}</span><span class="eyebrow">{item.category}</span></div>
            <h3>{item.name}</h3>
            <p>{item.description}</p>
            <h4>{c.evidenceH4}</h4>
            <ul>{item.demonstrates.map((skill) => <li>{skill}</li>)}</ul>
            <p class="caveat"><strong>{c.scope}</strong> {item.limitation}</p>
            <div class="links">
              <a href={item.caseStudy}>{c.readCase}{lang !== 'en' && <abbr class="en" title={s.enBadgeTitle}>{s.enBadge}</abbr>} →</a>
              <a href={item.source} target="_blank" rel="noopener">{c.inspect}</a>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="code" aria-labelledby="code-heading">
      <div class="section-head">
        <p class="eyebrow">{c.codeEyebrow}</p>
        <h2 id="code-heading">{c.codeTitle}</h2>
        <p>{c.codeBody}</p>
      </div>
      <ul class="code-list">
        {c.code.map(([project, what, path]) => (
          <li>
            <a href={codeBase[project] + path} rel="noopener" target="_blank">
              <span class="meta">{project}</span>
              <span class="what">{what}</span>
              <code>{path}</code>
            </a>
          </li>
        ))}
      </ul>
    </section>

    <section id="evaluation" class="eval" aria-labelledby="eval-heading">
      <div class="section-head">
        <p class="eyebrow">{c.evalEyebrow}</p>
        <h2 id="eval-heading">{c.evalTitle}</h2>
        <p>{c.evalBody}</p>
      </div>
      <div class="table-wrap">
        <table>
          <thead><tr><th scope="col">{c.colDim}</th><th scope="col">{c.colStatus}</th><th scope="col">{c.colEvidence}</th></tr></thead>
          <tbody>
            {c.evalRows.map(([dim, st, note, path]) => (
              <tr>
                <th scope="row">{dim}</th>
                <td><span class={`badge ${st}`}>{statusLabel[st]}</span></td>
                <td>{note}{path && <> · <a href={evHref(path)} rel="noopener" target="_blank"><code>{path.replace(/^sx:/, '')}</code></a></>}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section class="evaluations" aria-labelledby="evaluation-heading">
      <div class="section-head">
        <p class="eyebrow">{c.roadmap}</p>
        <h2 id="evaluation-heading">{c.harnessTitle}</h2>
        <p>{c.harnessBody}</p>
        <ol class="harness">{c.harnessSteps.map((step) => <li>{step}</li>)}</ol>
        <p set:html={c.roadmapBody} />
      </div>
      <ol class="question-grid">
        {c.questions.map(([title, method], index) => (
          <li>
            <span class="meta">{String(index + 1).padStart(2, '0')} / {c.toRun}</span>
            <h3>{title}</h3>
            <p>{method}</p>
          </li>
        ))}
      </ol>
      <p class="gap" set:html={c.notClaimed} />
    </section>

    <section class="community" aria-labelledby="community-heading">
      <div class="section-head">
        <p class="eyebrow">{c.community}</p>
        <h2 id="community-heading">{c.communityTitle}</h2>
        <p>{c.communityBody}</p>
      </div>
      <div class="community-links">
        {c.links.map(([name, body], i) => (
          <a href={communityHrefs[i]} {...(communityHrefs[i].startsWith('http') ? { rel: 'noopener', target: '_blank' } : {})}>
            <strong>{name}</strong><span>{body}</span>
          </a>
        ))}
      </div>
      <p class="small-print">{c.smallPrint}</p>
    </section>

    <section class="closing" aria-labelledby="closing-heading">
      <h2 id="closing-heading">{c.closingTitle}</h2>
      <p>{c.closingBody}</p>
      <div class="actions">
        <a class="btn primary" href={L('/contact/')}>{c.contactMe}</a>
        <a class="btn" href={L('/about/')}>{c.background}</a>
      </div>
    </section>
  </div>
</Base>

<style>
  .page-head h1 { max-width: 20ch; }
  .actions { display: flex; gap: var(--s-3); flex-wrap: wrap; margin-top: var(--s-5); }
  .content { padding-top: var(--s-7); display: grid; gap: var(--s-8); }
  .principle-grid, .system-grid, .question-grid { display: grid; gap: var(--s-4); grid-template-columns: repeat(auto-fit, minmax(min(100%, 19rem), 1fr)); }
  .principle-grid article, .system, .question-grid li { padding: var(--s-5); border: 1px solid var(--rule); background: var(--bg-raised); border-radius: var(--radius); }
  h3 { font-size: var(--fs-md); font-weight: 600; }
  h4 { font-size: var(--fs-sm); font-weight: 600; }
  .principle-grid article, .system, .question-grid li { display: grid; gap: var(--s-3); align-content: start; }
  .principle-grid p, .system p, .question-grid p { color: var(--ink-2); font-size: var(--fs-sm); }
  .system-top { display: flex; gap: var(--s-3); justify-content: space-between; flex-wrap: wrap; }
  .system-top .eyebrow { text-align: right; }
  .system ul { padding-left: var(--s-5); font-size: var(--fs-sm); }
  .system li + li { margin-top: var(--s-1); }
  .system .caveat { border-top: 1px solid var(--rule); padding-top: var(--s-3); }
  .links { display: flex; flex-wrap: wrap; gap: var(--s-3); margin-top: auto; font-size: var(--fs-sm); }
  .links a:first-child { font-weight: 600; }
  .question-grid { list-style: none; padding: 0; }
  .gap { padding: var(--s-4); border-left: 2px solid var(--accent); background: var(--bg-sunken); font-size: var(--fs-sm); color: var(--ink-2); }
  .community-links { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr)); gap: var(--s-3); }
  .community-links a { display: grid; gap: var(--s-2); border-top: 1px solid var(--rule-strong); padding-block: var(--s-4); text-decoration: none; }
  .community-links span { font-size: var(--fs-sm); color: var(--ink-2); }
  .small-print { font-size: var(--fs-sm); color: var(--ink-3); margin-top: var(--s-3); }
  .closing { border-top: 1px solid var(--rule); padding-top: var(--s-7); }
  .closing h2 { font-family: var(--font-display); font-weight: 500; font-size: var(--fs-xl); }
  .closing p { max-width: 64ch; margin-top: var(--s-3); color: var(--ink-2); }
  .content > * { min-width: 0; }
  .table-wrap { overflow-x: auto; border: 1px solid var(--rule); border-radius: var(--radius); background: var(--bg-raised); }
  table { width: 100%; border-collapse: collapse; font-size: var(--fs-sm); }
  th, td { text-align: left; padding: 0.6rem 0.85rem; border-bottom: 1px solid var(--rule); vertical-align: top; }
  thead th { font-family: var(--font-mono); font-size: var(--fs-xs); font-weight: 500; text-transform: uppercase; letter-spacing: 0.06em; color: var(--ink-3); }
  tbody th { font-weight: 600; min-width: 11rem; }
  tbody tr:last-child > * { border-bottom: 0; }
  td code { font-family: var(--font-mono); font-size: 0.78rem; overflow-wrap: anywhere; }
  .badge { display: inline-block; white-space: nowrap; font-family: var(--font-mono); font-size: 0.7rem; padding: 0.1rem 0.45rem; border-radius: 2px; border: 1px solid var(--rule-strong); }
  .badge.ci { background: var(--ink); color: var(--bg); border-color: var(--ink); }
  .badge.partial { border-color: var(--accent); color: var(--accent-ink); }
  .badge.planned { color: var(--ink-3); border-style: dashed; }
  .harness { padding-left: 1.3em; display: grid; gap: var(--s-1); color: var(--ink-2); max-width: 70ch; }
  .code-list { list-style: none; padding: 0; border-top: 1px solid var(--rule); display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 24rem), 1fr)); column-gap: var(--s-6); }
  .code-list li { border-bottom: 1px solid var(--rule); }
  .code-list a { display: grid; grid-template-columns: 6rem 1fr; gap: var(--s-1) var(--s-3); padding-block: var(--s-3); text-decoration: none; }
  .code-list .meta { padding-top: 0.2rem; }
  .code-list .what { font-weight: 550; font-size: var(--fs-sm); }
  .code-list code { grid-column: 2; font-family: var(--font-mono); font-size: var(--fs-xs); color: var(--ink-3); overflow-wrap: anywhere; }
  .code-list a:hover .what { color: var(--accent-ink); }
</style>
