---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import EntryList from '../components/EntryList.astro';
import { SITE, readingTime } from '../lib/site';
import { getLang, localize, t, type Lang } from '../lib/i18n';

const lang = getLang(Astro.url);
const s = t(lang);
const L = (path: string) => localize(path, lang);

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const featured = projects.filter((p) => p.data.featured);

const research = (await getCollection('research', (e) => !e.data.draft)).map((e) => ({
  href: `/research/${e.id}/`,
  title: lang === 'en' ? e.data.title : e.data.l10n[lang].title,
  description: lang === 'en' ? e.data.description : e.data.l10n[lang].description,
  date: e.data.created,
  label: `${e.data.type} · ${e.data.status}`,
  localized: lang !== 'en',
}));
const articles = (await getCollection('writing', (e) => !e.data.draft && e.data.kind === 'article')).map((e) => ({
  href: `/${e.data.slug}/`,
  title: e.data.title,
  description: e.data.description,
  date: e.data.created,
  label: e.data.topic,
  minutes: readingTime(e.body),
}));
const latest = [...research, ...articles].sort((a, b) => +b.date - +a.date).slice(0, 3);

const copy = {
  en: {
    intro: 'I build agent systems, AI applications and developer tools. Acthelm coordinates AI agents around persistent company state and human approval. SigSieve filters SSH agent forwarding while keeping private keys in your existing agent. Seerxo brings Etsy listing audits and AI-assisted workflows to CLI and MCP clients.',
    ctaAi: 'Explore AI engineering', ctaProjects: 'View projects', ctaContact: 'Contact me',
    glance: 'Profile at a glance',
    glanceRows: [
      ['Target roles', 'AI Engineer · Applied AI Engineer · Agentic AI / LLM Engineer · AI Product Engineer'],
      ['Specialisation', 'Agentic AI, autonomous workflows and LLM application engineering'],
      ['Core stack', 'Python · TypeScript / Node.js · Go · Rust · PostgreSQL · Redis · Docker · CI/CD · MCP'],
      ['Education', 'B.Sc. Computer Engineering, Karabük University'],
    ],
    links: 'Links',
    workEyebrow: 'Featured engineering work', workTitle: 'Acthelm, SigSieve & Seerxo',
    workBody: 'Each case study covers the problem, architecture, my role (including AI-assisted development), decisions, evidence and open limitations.',
    workMoreAi: 'How these projects demonstrate AI engineering →', workMoreAll: 'All projects →',
    ossEyebrow: 'Open source & community', ossTitle: 'Tools other developers can use',
    ossBody: 'SigSieve (MIT), the Seerxo client and MCP server (MIT) and Bridge (Apache-2.0) are open source with install guides, issue trackers and security policies. Acthelm is public to read but not yet licensed.',
    ossMore: 'Open source overview →',
    writingEyebrow: 'Research & writing', writingTitle: 'Latest notes', writingMore: 'All writing →', researchMore: 'Research journal →',
    contactEyebrow: 'Contact', contactTitle: 'Hiring for an AI engineering role?',
    contactBody: 'I am looking for AI Engineer, Applied AI Engineer and LLM / Agent Engineering roles, including international and remote teams. Email is the most direct way to reach me.',
    contactAll: 'All contact options',
  },
  tr: {
    intro: 'Ajan sistemleri, AI uygulamaları ve geliştirici araçları geliştiriyorum. Acthelm, AI ajanlarını kalıcı şirket verisi ve insan onayı etrafında koordine ediyor. SigSieve, özel anahtarları mevcut agent’ınızda tutarak SSH agent yönlendirmesini filtreliyor. Seerxo, Etsy ilan denetimini ve AI destekli iş akışlarını CLI ve MCP istemcilerine taşıyor.',
    ctaAi: 'AI mühendisliğini incele', ctaProjects: 'Projeleri gör', ctaContact: 'İletişime geç',
    glance: 'Kısaca profil',
    glanceRows: [
      ['Hedef pozisyonlar', 'AI Engineer · Applied AI Engineer · Agentic AI / LLM Engineer · AI Product Engineer'],
      ['Uzmanlık', 'Agentic AI, otonom iş akışları ve LLM uygulama mühendisliği'],
      ['Temel teknolojiler', 'Python · TypeScript / Node.js · Go · Rust · PostgreSQL · Redis · Docker · CI/CD · MCP'],
      ['Eğitim', 'Bilgisayar Mühendisliği lisans, Karabük Üniversitesi'],
    ],
    links: 'Bağlantılar',
    workEyebrow: 'Öne çıkan mühendislik çalışmaları', workTitle: 'Acthelm, SigSieve ve Seerxo',
    workBody: 'Her vaka çalışması problemi, mimariyi, rolümü (AI destekli geliştirme dahil), kararları, kanıtları ve açık sınırlamaları anlatır (İngilizce).',
    workMoreAi: 'Bu projeler AI mühendisliğini nasıl gösteriyor →', workMoreAll: 'Tüm projeler →',
    ossEyebrow: 'Açık kaynak ve topluluk', ossTitle: 'Diğer geliştiricilerin kullanabileceği araçlar',
    ossBody: 'SigSieve (MIT), Seerxo istemcisi ve MCP sunucusu (MIT) ve Bridge (Apache-2.0); kurulum rehberleri, issue takibi ve güvenlik politikalarıyla açık kaynak. Acthelm’in kaynak kodu okunabilir, ancak henüz lisanslı değil.',
    ossMore: 'Açık kaynak özeti →',
    writingEyebrow: 'Araştırma ve yazılar', writingTitle: 'Son notlar', writingMore: 'Tüm yazılar →', researchMore: 'Araştırma günlüğü →',
    contactEyebrow: 'İletişim', contactTitle: 'AI mühendisliği pozisyonu için mi arıyorsunuz?',
    contactBody: 'Uluslararası ve uzaktan çalışan ekipler dahil AI Engineer, Applied AI Engineer ve LLM / Agent Engineering pozisyonlarıyla ilgileniyorum. Bana en doğrudan e-posta ile ulaşabilirsiniz.',
    contactAll: 'Tüm iletişim seçenekleri',
  },
  de: {
    intro: 'Ich entwickle Agentensysteme, KI-Anwendungen und Entwickler-Tools. Acthelm koordiniert KI-Agenten mit persistentem Unternehmenszustand und menschlicher Freigabe. SigSieve filtert die SSH-Agent-Weiterleitung; private Schlüssel bleiben im vorhandenen Agent. Seerxo bringt Etsy-Listing-Prüfungen und KI-gestützte Abläufe in CLI- und MCP-Clients.',
    ctaAi: 'AI Engineering ansehen', ctaProjects: 'Projekte ansehen', ctaContact: 'Kontakt aufnehmen',
    glance: 'Profil auf einen Blick',
    glanceRows: [
      ['Zielrollen', 'AI Engineer · Applied AI Engineer · Agentic AI / LLM Engineer · AI Product Engineer'],
      ['Schwerpunkt', 'Agentic AI, autonome Workflows und LLM-Anwendungsentwicklung'],
      ['Kern-Stack', 'Python · TypeScript / Node.js · Go · Rust · PostgreSQL · Redis · Docker · CI/CD · MCP'],
      ['Ausbildung', 'B.Sc. Computer Engineering, Universität Karabük'],
    ],
    links: 'Links',
    workEyebrow: 'Ausgewählte Projekte', workTitle: 'Acthelm, SigSieve & Seerxo',
    workBody: 'Jede Fallstudie behandelt Problem, Architektur, meine Rolle (einschließlich KI-gestützter Entwicklung), Entscheidungen, Belege und offene Grenzen (auf Englisch).',
    workMoreAi: 'Wie diese Projekte AI Engineering belegen →', workMoreAll: 'Alle Projekte →',
    ossEyebrow: 'Open Source & Community', ossTitle: 'Werkzeuge, die andere Entwickler nutzen können',
    ossBody: 'SigSieve (MIT), der Seerxo-Client mit MCP-Server (MIT) und Bridge (Apache-2.0) sind Open Source, mit Installationsanleitungen, Issue-Trackern und Security-Policies. Acthelm ist öffentlich lesbar, aber noch nicht lizenziert.',
    ossMore: 'Open-Source-Überblick →',
    writingEyebrow: 'Recherche & Artikel', writingTitle: 'Neueste Beiträge', writingMore: 'Alle Artikel →', researchMore: 'Recherche-Journal →',
    contactEyebrow: 'Kontakt', contactTitle: 'Sie besetzen eine AI-Engineering-Stelle?',
    contactBody: 'Ich suche Rollen als AI Engineer, Applied AI Engineer und LLM-/Agent-Engineer, auch in internationalen und Remote-Teams. Am direktesten erreichen Sie mich per E-Mail.',
    contactAll: 'Alle Kontaktmöglichkeiten',
  },
} satisfies Record<Lang, unknown>;
const c = copy[lang];

---

<Base>
  <section class="hero grid-bg" aria-labelledby="hero-title">
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <p class="eyebrow"><span class="idx">sezz.dev</span> <span set:html={s.roleHtml} /></p>
        <p class="open"><span class="dot" aria-hidden="true"></span>{s.openToWork}</p>
        <h1 id="hero-title">Semih Buğra Sezer</h1>
        <p class="tagline">{s.tagline}</p>
        <p class="intro">{c.intro}</p>
        <div class="actions">
          <a class="btn primary" href={L('/ai-engineering/')}>{c.ctaAi} <span class="arrow" aria-hidden="true">→</span></a>
          <a class="btn" href={L('/projects/')}>{c.ctaProjects}</a>
          <a class="btn" href={L('/contact/')}>{c.ctaContact}</a>
        </div>
      </div>

      <aside class="spec" aria-labelledby="glance-h">
        <p class="eyebrow" id="glance-h">{c.glance}</p>
        <dl>
          {c.glanceRows.map(([k, v]) => (
            <div class="spec-row"><dt>{k}</dt><dd>{v}</dd></div>
          ))}
          <div class="spec-row">
            <dt>{c.links}</dt>
            <dd class="spec-links">
              <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
              <a href={SITE.linkedin} rel="me noopener" target="_blank">LinkedIn</a>
              <a href={SITE.github} rel="me noopener" target="_blank">GitHub</a>
            </dd>
          </div>
        </dl>
      </aside>
    </div>
  </section>

  <section class="section" aria-labelledby="work-title">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow"><span class="idx">01</span> {c.workEyebrow}</p>
        <h2 id="work-title">{c.workTitle}</h2>
        <p>{c.workBody}</p>
      </div>
      <div class="featured">
        {featured.map((p, i) => <ProjectCard project={p} index={i + 1} large />)}
      </div>
      <p class="more-link"><a href={L('/ai-engineering/')}>{c.workMoreAi}</a> · <a href={L('/projects/')}>{c.workMoreAll}</a></p>
    </div>
  </section>



  <section class="section" aria-labelledby="oss-title">
    <div class="wrap two-col">
      <div class="section-head">
        <p class="eyebrow"><span class="idx">02</span> {c.ossEyebrow}</p>
        <h2 id="oss-title">{c.ossTitle}</h2>
      </div>
      <div>
        <p class="lead-p">{c.ossBody}</p>
        <p class="more-link"><a href={L('/open-source/')}>{c.ossMore}</a></p>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="writing-title">
    <div class="wrap two-col">
      <div class="section-head">
        <p class="eyebrow"><span class="idx">03</span> {c.writingEyebrow}</p>
        <h2 id="writing-title">{c.writingTitle}</h2>
        <p class="meta"><a href={L('/research/')}>{c.researchMore}</a> · <a href={L('/writing/')}>{c.writingMore}</a></p>
      </div>
      <EntryList items={latest} />
    </div>
  </section>

  <section class="section" aria-labelledby="contact-title">
    <div class="wrap contact">
      <div class="section-head">
        <p class="eyebrow"><span class="idx">04</span> {c.contactEyebrow}</p>
        <h2 id="contact-title">{c.contactTitle}</h2>
        <p>{c.contactBody}</p>
      </div>
      <div class="actions">
        <a class="btn primary" href={`mailto:${SITE.email}`}>{s.email}: {SITE.email}</a>
        <a class="btn" href={SITE.linkedin} rel="noopener" target="_blank">LinkedIn</a>
        <a class="btn" href={L('/contact/')}>{c.contactAll}</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .hero { border-bottom: 1px solid var(--rule); }
  .hero-grid { display: grid; gap: var(--s-7); padding-block: var(--s-9) var(--s-8); align-items: end; }
  @media (min-width: 60rem) { .hero-grid { grid-template-columns: minmax(0, 1.55fr) minmax(0, 1fr); } }
  .hero h1 {
    font-family: var(--font-display); font-weight: 500; font-size: var(--fs-hero);
    letter-spacing: -0.035em; line-height: 0.98; margin-block: var(--s-4) var(--s-5);
  }
  .open { display: inline-flex; align-items: center; gap: 0.5rem; margin-top: var(--s-3); padding: 0.3rem 0.75rem; border: 1px solid var(--rule-strong); border-radius: 999px; background: var(--bg-raised); font-size: var(--fs-sm); font-weight: 550; }
  .open .dot { width: 8px; height: 8px; border-radius: 50%; background: #2f9e5b; box-shadow: 0 0 0 3px color-mix(in srgb, #2f9e5b 25%, transparent); }
  .tagline { font-family: var(--font-display); font-size: var(--fs-lg); line-height: 1.35; max-width: 30ch; color: var(--ink); font-style: italic; }
  .intro { margin-top: var(--s-4); color: var(--ink-2); max-width: 58ch; }
  .actions { display: flex; flex-wrap: wrap; gap: var(--s-3); margin-top: var(--s-6); }

  .spec { border: 1px solid var(--rule-strong); background: var(--bg-raised); border-radius: var(--radius); padding: var(--s-5); }
  .spec dl { margin-top: var(--s-3); }
  .spec-row { display: grid; gap: var(--s-1); padding-block: var(--s-3); border-top: 1px solid var(--rule); }
  .spec-row:first-child { border-top: 0; }
  .spec dt { font-weight: 600; }
  .spec dt { font-family: var(--font-mono); font-size: var(--fs-xs); font-weight: 500; color: var(--ink-3); text-transform: uppercase; letter-spacing: 0.06em; }
  .spec dd { font-size: var(--fs-sm); color: var(--ink); }
  .spec-links { display: flex; flex-wrap: wrap; gap: var(--s-1) var(--s-4); }
  .spec-foot { border-top: 1px solid var(--rule); padding-top: var(--s-3); }


  .featured { display: grid; gap: var(--s-4); grid-template-columns: repeat(auto-fit, minmax(min(100%, 19rem), 1fr)); }
  .more-link { margin-top: var(--s-5); font-size: var(--fs-sm); }

  .two-col { display: grid; gap: var(--s-6); align-items: start; }
  @media (min-width: 60rem) { .two-col { grid-template-columns: minmax(0, 1fr) minmax(0, 2fr); } }
  .exploring { list-style: none; padding: 0; display: grid; gap: var(--s-4); }
  .exploring li { padding-left: var(--s-5); border-left: 1px solid var(--rule-strong); color: var(--ink-2); }
  .exploring strong { color: var(--ink); font-weight: 600; }
  .contact .actions { margin-top: 0; }
  .lead-p { color: var(--ink-2); max-width: 62ch; }
</style>
